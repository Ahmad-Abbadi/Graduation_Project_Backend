@model Graduation_Project_Backend.Models.ViewModels.ManagerStoreManagersPageViewModel
@{
    Layout = "_ManagerLayout";
    ViewData["Title"] = "Store Managers";
    bool isEditing = Model.IsEditing;
    string formAction = isEditing ? "/manager/store-managers/update" : "/manager/store-managers";
}

<section class="page-heading">
    <div><p class="eyebrow">Manager</p><h1>Store managers</h1></div>
    @if (isEditing)
    {
        <a class="button ghost" href="/manager/store-managers">Cancel editing</a>
    }
</section>

<section class="two-column">
    <form class="panel form-panel" method="post" action="@formAction">
        <h2>@(isEditing ? "Update store manager" : "Create store manager")</h2>
        @if (isEditing)
        {
            <input type="hidden" name="Id" value="@Model.Form.Id">
        }
        <label>Name<input name="Name" value="@Model.Form.Name" type="text" required placeholder="Manager name"></label>
        <label>Phone number<input name="PhoneNumber" value="@Model.Form.PhoneNumber" type="text" required placeholder="07XXXXXXXX"></label>
        <label>
            Password
            @if (isEditing)
            {
                <input name="Password" type="password" placeholder="Leave blank to keep current password">
            }
            else
            {
                <input name="Password" type="password" required placeholder="Temporary password">
            }
        </label>
        <div class="checkbox-list">
            <strong>Assign stores</strong>
            <p>At least one store is required. Store managers cannot be mall-wide.</p>
            @foreach (var store in Model.Stores)
            {
                <label>
                    <input type="checkbox" name="StoreIds" value="@store.Id" checked="@(Model.Form.StoreIds.Contains(store.Id))">
                    <span>@store.Name</span>
                    <small>@store.MallName</small>
                </label>
            }
        </div>
        <button type="submit">@(isEditing ? "Save changes" : "Create store manager")</button>
    </form>

    <section class="panel">
        <h2>Store managers</h2>
        <div class="table-wrap">
            <table>
                <thead><tr><th>Name</th><th>Phone</th><th>Role</th><th>Stores</th><th></th></tr></thead>
                <tbody>
                @foreach (var manager in Model.Managers)
                {
                    <tr>
                        <td>@manager.Name</td>
                        <td>@manager.PhoneNumber</td>
                        <td>@manager.Role</td>
                        <td>@string.Join(", ", manager.AssignedStoreNames)</td>
                        <td class="actions-cell">
                            <a class="text-link" href="/manager/store-managers?editManagerId=@manager.Id">Edit</a>
                            <form method="post" action="/manager/store-managers/delete">
                                <input type="hidden" name="managerId" value="@manager.Id">
                                <button class="link-button danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
