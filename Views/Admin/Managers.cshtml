@model Graduation_Project_Backend.Models.ViewModels.AdminManagersPageViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Managers";
    bool isEditing = Model.IsEditing;
    string formAction = isEditing ? "/admin/managers/update" : "/admin/managers";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">Admin</p>
        <h1>Managers</h1>
    </div>
    @if (isEditing)
    {
        <a class="button ghost" href="/admin/managers">Cancel editing</a>
    }
</section>

<section class="two-column">
    <form class="panel form-panel" method="post" action="@formAction">
        <h2>@(isEditing ? "Update manager" : "Create manager")</h2>
        @if (isEditing)
        {
            <input type="hidden" name="Id" value="@Model.Form.Id">
        }
        <label>
            Mall
            <select name="MallID" required>
                <option value="">Choose a mall</option>
                @foreach (var mall in Model.MallOptions)
                {
                    <option value="@mall.Value" selected="@(mall.Value == Model.Form.MallID.ToString())">@mall.Text</option>
                }
            </select>
        </label>
        <label>
            Manager name
            <input name="Name" value="@Model.Form.Name" type="text" maxlength="200" required placeholder="Manager name">
        </label>
        <label>
            Phone number
            <input name="PhoneNumber" value="@Model.Form.PhoneNumber" type="text" required placeholder="07XXXXXXXX">
        </label>
        <label>
            Password
            @if (isEditing)
            {
                <input name="Password" type="password" placeholder="Leave blank to keep current password">
            }
            else
            {
                <input name="Password" type="password" required placeholder="Temporary password">
            }
        </label>
        <label>
            Role
            <input name="Role" value="@Model.Form.Role" type="text" maxlength="100" placeholder="manager">
        </label>
        <div class="checkbox-list">
            <strong>Store scope</strong>
            <p>Leave all stores unchecked to make this manager mall-wide.</p>
            @foreach (var store in Model.Stores)
            {
                <label>
                    <input type="checkbox" name="StoreIds" value="@store.Id" checked="@(Model.Form.StoreIds.Contains(store.Id))">
                    <span>@store.Name</span>
                    <small>@store.MallName</small>
                </label>
            }
        </div>
        <button type="submit">@(isEditing ? "Save changes" : "Create manager")</button>
    </form>

    <section class="panel">
        <h2>Managers</h2>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Mall</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Scope</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var manager in Model.Managers)
                {
                    <tr>
                        <td>@manager.Name</td>
                        <td>@manager.MallName</td>
                        <td>@manager.PhoneNumber</td>
                        <td>@manager.Role</td>
                        <td>
                            @if (manager.IsMallWideManager)
                            {
                                <span class="pill">Mall-wide</span>
                            }
                            else
                            {
                                <span>@string.Join(", ", manager.AssignedStoreNames)</span>
                            }
                        </td>
                        <td class="actions-cell">
                            <a class="text-link" href="/admin/managers?editManagerId=@manager.Id">Edit</a>
                            <form method="post" action="/admin/managers/delete">
                                <input type="hidden" name="managerId" value="@manager.Id">
                                <button class="link-button danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
