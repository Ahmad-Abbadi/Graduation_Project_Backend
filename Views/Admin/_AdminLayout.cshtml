@{
    string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    string title = ViewData["Title"]?.ToString() ?? "Admin";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@title - YALLAH REWARDS</title>
    <link rel="stylesheet" href="/css/admin-console.css">
</head>
<body>
    <div class="admin-shell">
        <aside class="sidebar">
            <div class="brand">
                <span class="brand-mark">YR</span>
                <div>
                    <strong>YALLAH REWARDS</strong>
                    <span>Admin console</span>
                </div>
            </div>
            <nav class="nav">
                <a class="@(currentAction == "Index" ? "active" : "")" href="/admin">Overview</a>
                <a class="@(currentAction == "Dashboard" ? "active" : "")" href="/admin/dashboard">Dashboard</a>
                <a class="@(currentAction == "Malls" ? "active" : "")" href="/admin/malls">Malls</a>
                <a class="@(currentAction == "Stores" ? "active" : "")" href="/admin/stores">Stores</a>
                <a class="@(currentAction == "Managers" ? "active" : "")" href="/admin/managers">Managers</a>
                <a href="/portal/account">Account</a>
            </nav>
            <form class="logout-form" method="post" action="/portal/logout">
                <button type="submit">Logout</button>
            </form>
        </aside>
        <main class="content">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert success">@successMessage</div>
            }
            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert error">@errorMessage</div>
            }
            @RenderBody()
        </main>
    </div>
</body>
</html>
